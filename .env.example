# Every setting here is optional: the server starts with none of them.
# This file is read from the folder the server is started in (and by docker compose).

# The API token of the administrator account "Admin". Leave it empty and a token is created
# on the first start and saved in the data folder (shown by: hoepedia-api token).
# Set it yourself (a long random string) when several nodes must share it.
ADMIN_TOKEN=

# Running the program directly (not Docker): where it listens and keeps its data.
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from other machines.
#BIND_ADDR=127.0.0.1
#PORT=3000
#DATABASE_PATH=./data/wiki.db

SITE_NAME=Hoepedia
# Where rendered internal links point. {title} is replaced by the encoded page title.
# Set this to your frontend's URL scheme, e.g. https://wiki.example.com/wiki/{title}
ARTICLE_PATH=/wiki/{title}

# --- Access policy ---
# false = private wiki: every request needs a token
ANON_READ=true
# true = anyone may edit/create pages
ANON_EDIT=false
# What history records for anonymous editors:
#   ip     = the address (MediaWiki behaviour)
#   masked = 203.0.113.x
#   hashed = a stable pseudonym such as Anon-3fa9c1d2e0; the address itself is never stored
ANON_IDENTITY=ip
# Browser origins allowed to call the API: * (any) or a comma-separated list,
# e.g. https://wiki.example.com,https://admin.example.com
CORS_ORIGINS=*

# --- Host-side port mapping (compose binds to localhost by default) ---
HOST_BIND=127.0.0.1
HOST_PORT=3000

# --- Limits ---
MAX_PAGE_BYTES=2000000
# Per IP, 0 = off
RATE_LIMIT_PER_MIN=300
# Only set true behind a reverse proxy you control (reads X-Forwarded-For)
TRUST_PROXY=false
REQUEST_TIMEOUT_SECS=25

# --- Performance ---
READ_CONNECTIONS=4
RENDER_CACHE_ENTRIES=5000
# Pages re-indexed synchronously when a template changes
REFRESH_LINKS_LIMIT=500
# Cache-Control max-age on GETs (0 = always revalidate via ETag)
CACHE_MAX_AGE_SECS=0

# --- Files ---
# Where [[File:x]] embeds point; {name} is replaced by the encoded file name.
# Point this at your CDN/front end if you serve files elsewhere.
FILE_PATH=/rest/v1/file/{name}
UPLOAD_MAX_BYTES=10000000
# SVG uploads are sanitised (scripts, external references, etc. removed) before being stored.
ALLOW_SVG=true
# Thumbnails (?width=N): largest image the server will decode, and the memory cache size.
THUMB_MAX_MEGAPIXELS=25
THUMB_CACHE_BYTES=64000000

# Persistent thumbnail cache (default: a "thumbs" folder next to the database; off = memory only)
THUMB_DIR=
THUMB_DISK_BYTES=512000000

# PDF, video and audio previews use Poppler (pdftoppm, pdfinfo) and ffmpeg (ffmpeg, ffprobe) when
# they are installed (the Docker image has them). off = no previews. The *_PATH settings point at
# the programs if they are not in PATH.
MEDIA_PREVIEWS=on
#FFMPEG_PATH=
#FFPROBE_PATH=
#PDFTOPPM_PATH=
#PDFINFO_PATH=

# --- Language and time ---
# IANA zone used by {{#timel:}} and {{LOCALTIME}} etc. ({{#time:}} is always UTC).
TIMEZONE=UTC
# Content language code reported by the API and to Lua modules.
SITE_LANG=en

# --- Interwiki ---
# How long a copy of a transcluded remote page counts as fresh (seconds). Older copies are still
# used while a new one is fetched in the background.
INTERWIKI_CACHE_SECS=3600
# How often other wikis are asked for changes to the pages this wiki uses (seconds; 0 = never).
INTERWIKI_POLL_SECS=60

# --- Replicas / maintenance mode ---
# true = every write is rejected with 503 (reads, backups and feeds keep working).
READ_ONLY=false
# Live read replica: set both on the replica instance (leave empty on the primary).
# REPLICA_OF is the primary's base URL, REPLICA_TOKEN a sysop token on the primary.
# The replica copies the whole wiki, then follows changes within about a second.
REPLICA_OF=
REPLICA_TOKEN=
# Replicas pass write requests on to the primary (clients can use any node).
REPLICA_FORWARD_WRITES=true
# Primary: wait until this many replicas confirmed each write (0 = don't wait).
REPL_MIN_ACKS=0
REPL_ACK_TIMEOUT_MS=2000
# Automatic fail-over by majority vote: use 3 or more nodes. Give every node the URLs of all
# nodes (including itself), the same ADMIN_TOKEN, and REPLICA_TOKEN equal to that ADMIN_TOKEN.
# Writes then need a majority to confirm them; a primary that loses the majority stops taking
# writes; a new primary needs a majority of votes. FAILOVER_AFTER_SECS = how long the primary
# must be unreachable before an election (0 = fail-over by hand only).
PEERS=
FAILOVER_AFTER_SECS=0
# Host port of the optional same-host replica (docker compose --profile replica up -d)
REPLICA_HOST_PORT=3001

RUST_LOG=info
